# Supabase PostgreSQL session pool connection
# Replace PROJECT_REF, REGION, and YOUR-PASSWORD locally. Do not commit real credentials.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_HOST=aws-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR-PASSWORD

# Fastify API runtime
API_HOST=127.0.0.1
API_PORT=8787
API_KEY=change-me
API_REQUIRE_KEY=false
PG_POOL_MAX=5
LOG_LEVEL=info

# Vite web runtime
VITE_API_BASE=/api
